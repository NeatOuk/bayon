#!/bin/sh
# git's credential helper for github.com in the Bayon image. It
# answers `get` with the token in the file store ($FRM_SECRETS_DIR/FRM_GIT_TOKEN) and ignores `store`
# and `erase`: git can neither write the token anywhere nor delete the file. printf is a shell
# builtin, so the token never appears in any process's argv.
[ "${1:-}" = get ] || exit 0
file="${FRM_SECRETS_DIR:-/run/secrets}/FRM_GIT_TOKEN"
[ -r "$file" ] || exit 0
cat >/dev/null
token=$(cat "$file")
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
