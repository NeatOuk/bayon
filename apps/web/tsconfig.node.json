{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Node side of the web app: the Vite config and its dev proxy.
    "rootDir": ".",
    "outDir": "${configDir}/dist/node",
    "tsBuildInfoFile": "${configDir}/dist/node/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "dev-proxy.ts",
    "dev-proxy.test.ts",
    "dev-config.ts",
    "dev-config.test.ts",
    "colours.test.ts",
    "theme-contrast.ts"
  ],
  // dev-proxy.ts imports the origin guard it shares with the production edge server; dev-config.ts
  // the install's ports and bearer.
  "references": [
    { "path": "./tsconfig.server.json" },
    { "path": "../../packages/core" },
    { "path": "../../packages/executors" }
  ]
}
