{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser code, bundled by Vite. `tsc -b` only checks it (declarations to dist/, never read);
    // `vite build` writes the app to dist/app/.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "emitDeclarationOnly": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/proto" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.server.json" }
  ]
}
